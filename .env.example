# Copy this file to .env and fill in the values. Never share .env or put it in git.

# Neon: Project > Dashboard > Connect > copy the connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Sign-in is OFF by default: anyone with the link opens the notebook straight away.
# To ask for an access code, set REQUIRE_LOGIN=true and fill in the two lines below.
REQUIRE_LOGIN=false
APP_PASSWORD=choose-a-long-access-code
SESSION_SECRET=replace-with-a-long-random-string

# Port for running on your own computer (hosts like Render set this themselves).
PORT=3000
