# Copy this file to .env and fill in the values. Never share .env or put it in git.

# Neon: Project > Dashboard > Connect > copy the connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# The access code you and your tutors type to open the notebook.
APP_PASSWORD=choose-a-long-access-code

# Any long random text; it signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# Port for running on your own computer (hosts like Render set this themselves).
PORT=3000
